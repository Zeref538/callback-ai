# Copy to .env and fill in. Nothing here is read until you actually run the app.

# ---- Provider -------------------------------------------------------------
# "nim"  -> NVIDIA NIM (needs NIM_API_KEY below)
# "mock" -> offline demo model, no key and no network required. The whole app
#           (CLI, API, web UI) runs on this; use it to try things or to keep a
#           deployed build clickable when the key is missing or credits run out.
CALLBACK_AI_PROVIDER=nim

# ---- NVIDIA NIM -----------------------------------------------------------
# Key from https://build.nvidia.com -> pick a model -> "Get API Key".
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a model id exactly as listed on build.nvidia.com, or you get a 404.
NIM_MODEL=meta/llama-3.3-70b-instruct

# ---- Local fallback (optional) --------------------------------------------
# Only used when NIM returns 429. Safe to leave as-is if you don't run Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
