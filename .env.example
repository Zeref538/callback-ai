# Copy to .env and fill in. Nothing here is read until you actually run the app.

# ---- Provider -------------------------------------------------------------
# "nim"  -> NVIDIA NIM (needs NIM_API_KEY below)
# "mock" -> offline demo model, no key and no network required. The whole app
#           (CLI, API, web UI) runs on this; use it to try things or to keep a
#           deployed build clickable when the key is missing or credits run out.
CALLBACK_AI_PROVIDER=nim

# ---- NVIDIA NIM -----------------------------------------------------------
# Key from https://build.nvidia.com -> pick a model -> "Get API Key".
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a model id NVIDIA is actually serving. Its /v1/models list includes
# retired models that answer 404, so test a new one before switching. A 410
# "Gone" error means NVIDIA has retired the model: pick another.
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# 70B free-tier calls can take a minute; keep this generous so they don't time out.
REQUEST_TIMEOUT_S=60

# ---- Local fallback (optional) --------------------------------------------
# Only used when NIM returns 429. Safe to leave as-is if you don't run Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Server ---------------------------------------------------------------
# Per-IP limit on POST /api/* requests per minute. A full interview is ~27.
RATE_LIMIT_PER_MIN=90
# Where callback-ai-serve listens. Hosts like Render set PORT themselves.
HOST=0.0.0.0
PORT=8000
# Keep at 1: interviews live in the server's memory, so a second worker
# can't see sessions the first one started.
WEB_CONCURRENCY=1
# RENDER is set to "true" by Render itself; don't set it locally. When set,
# the server is API-only and sends page visits to the Netlify site.
